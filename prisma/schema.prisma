generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                         String       @id @default(auto()) @map("_id") @db.ObjectId
  name                       String
  email                      String       @unique
  password                   String?
  role                       UserRoleEnum @default(USER)
  status                     UserStatus   @default(PENDING)
  image                      String?
  otp                        String?
  otpExpiry                  DateTime?
  notification               Boolean      @default(true)
  fcmToken                   String?
  firebaseUid                String?
  birthday                   String?
  age                        Int?
  number                     String?
  plan                       Plan         @default(FREE)
  relation                   String?
  address                    Json?
  skill                      String?
  forgetPasswordToken        String?
  forgetPasswordTokenExpires DateTime?
  goal                       String?
  focus                      String?
  isEmailVerified            Boolean      @default(false)
  language                   String?
  gender                     Gender       @default(MALE)
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  subscriptions UserSubscription[]
  contracts     Contract[]
  chats         Chat[]
  chatMessages  ChatMessage[]
  redeemCodes   RedeemCode[]
  userAccesses  UserAccess[]
  scanUsageLogs ScanUsageLog[]

  @@map("users")
}

enum Plan {
  FREE
  PREMIUM
}

enum UserRoleEnum {
  USER
  ADMIN
  SUPERADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PENDING
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

model SubscriptionPlan {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  name          String        @unique
  price         Float         @default(0) // human readable price in base currency (e.g. 9.99)
  currency      String        @default("usd")
  billingPeriod BillingPeriod @default(MONTHLY)
  isPopular     Boolean       @default(false)
  features      Json
  benefits      String[]
  productId     String? // Stripe product id (nullable for free plans)
  pricingId     String? // Stripe price id (nullable for free/lifetime)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  userSubscriptions UserSubscription[]
}

model UserSubscription {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  userId        String             @db.ObjectId
  planId        String             @db.ObjectId
  status        SubscriptionStatus @default(ACTIVE)
  startDate     DateTime           @default(now())
  endDate       DateTime?
  cancelAt      DateTime?
  paymentMethod String? // "stripe", "paypal" etc
  transactionId String? // store payment gateway ID (subscription id / payment id)
  autoRenew     Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // Relations
  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([userId, planId], name: "userId_planId_unique")
}

model SupportTicket {
  id       String          @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  email    String
  category SupportCategory
  subject  String
  message  String
  status   TicketStatus    @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contract {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  userId          String
  document_id     String?       @unique
  chatId          String?
  risk_level      String
  meaning_summary String
  key_risk_flags  KeyRiskFlag[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat Chat? @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

type KeyRiskFlag {
  title          String
  description    String
  why_it_matters String
}

enum MessageRole {
  USER
  ASSISTANT
}

model Chat {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  userId    String        @db.ObjectId
  title     String?
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  contracts Contract[]
}

model ChatMessage {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  userId    String      @db.ObjectId
  chatId    String      @db.ObjectId
  role      MessageRole
  content   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportCategory {
  GENERAL_INQUIRY
  TECHNICAL_ISSUE
  BILLING_PAYMENTS
  ACCOUNT_ACCESS
  FEATURE_REQUEST
  OTHER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  PENDING
}

model RedeemCode {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  code           String           @unique
  type           RedeemCodeType   @default(CREATOR_PASS)
  status         RedeemCodeStatus @default(ACTIVE)
  maxUses        Int              @default(1)
  usedCount      Int              @default(0)
  scansAllowed   Int              @default(5)
  batchId        String?          @db.ObjectId
  assignedUserId String?          @db.ObjectId
  redeemedAt     DateTime?
  expiresAt      DateTime?
  note           String?
  source         String?          @default("TikTok Shop")
  createdBy      String?          @db.ObjectId
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  batch        RedeemCodeBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  assignedUser User?            @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  userAccesses UserAccess[]

  @@map("redeem_codes")
}

enum RedeemCodeType {
  CREATOR_PASS
  AFFILIATE
}

enum RedeemCodeStatus {
  ACTIVE
  USED
  EXPIRED
  DISABLED
}

model RedeemCodeBatch {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  type         RedeemCodeType @default(CREATOR_PASS)
  quantity     Int
  scansAllowed Int            @default(5)
  source       String?        @default("TikTok Shop")
  createdBy    String?        @db.ObjectId
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  codes RedeemCode[]

  @@map("redeem_code_batches")
}

model UserAccess {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  userId         String           @db.ObjectId
  sourceCodeId   String?          @db.ObjectId
  accessType     AccessType       @default(CREATOR_PASS)
  scansRemaining Int              @default(5)
  scansUsed      Int              @default(0)
  status         UserAccessStatus @default(ACTIVE)
  activatedAt    DateTime         @default(now())
  expiredAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user       User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceCode RedeemCode?   @relation(fields: [sourceCodeId], references: [id], onDelete: SetNull)
  usages     ScanUsageLog[]

  @@map("user_accesses")
}

enum AccessType {
  CREATOR_PASS
  SUBSCRIPTION
}

enum UserAccessStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
}

model ScanUsageLog {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String     @db.ObjectId
  accessId  String?    @db.ObjectId
  scanType  String?    @default("default")
  status    ScanStatus @default(SUCCESS)
  reason    String?
  createdAt DateTime   @default(now())

  user   User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  access UserAccess? @relation(fields: [accessId], references: [id], onDelete: SetNull)

  @@map("scan_usage_logs")
}

enum ScanStatus {
  SUCCESS
  FAILED
  BLOCKED
}
